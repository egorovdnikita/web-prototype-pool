# Хэш пароля на вход в прототип: SHA-256 от пароля, без самого пароля.
# Задаётся командой `npm run gate` в файле .env.local (он не в git).
# Переменной нет — щеколды нет, прототип открывается сразу.
VITE_GATE_HASH=

# Адрес прокси для чата и щеколда к нему (см. worker/README.md).
# Пусто — чат разбирает запросы локально, без модели.
VITE_AI_URL=
VITE_AI_TOKEN=
